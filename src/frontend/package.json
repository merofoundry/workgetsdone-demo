{
  "name": "workgetsdone-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "dev": "npm run tokens && vite --host 127.0.0.1",
    "build": "npm run tokens && tsc -b && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && npm run test:tokens",
    "test:tokens": "node --test scripts/generate-tokens.test.mjs",
    "test:browser": "playwright test",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "package": "python3 scripts/package-site.py"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.1",
    "@tanstack/react-query": "5.90.2",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@storybook/react-vite": "8.6.18",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "storybook": "8.6.18",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "6.4.4",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "3.2.7"
  }
}
