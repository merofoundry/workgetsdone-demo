  "ebb5f307-48dc-4d23-bacb-e73534d08e77": {
    "op": "update_rule",
    "body": {
      "condition": {
        "==": [
          1,
          1
        ]
      },
      "trigger": "record_create",
      "phase": "post_save",
      "priority": 100,
      "isActive": true,
      "run_as": "actor",
      "scope": {},
      "settings": {
        "on_failure": "abort"
      },
      "name": "Grant Company Permissions to Creator",
      "description": "After an authenticated public form creates a Company, grant that app user full permission bits (15) with the can_* projections and the write-bit mirror (Kit-A, R-L). Kit-C: scope = subtree so the creator also reaches records others later add under it (PERM-08/15). settings.on_failure = abort makes the create fail if the grant cannot be written (PERM-03). Fix round 1: access_label is now stamped, so the creator row carries the same named level the sharing UI renders for every other grant. Full build Task 9 (Rob approved 2026-10-11): the trailing redirect action was removed because it fails ('Invalid redirect target') when the create comes from a BYOF service.",
      "actions": [
        {
          "data": {
            "scope": "subtree",
            "source": "creator",
            "user_id": {
              "var": "actor.id"
            },
            "can_share": true,
            "can_write": true,
            "perm_bits": 15,
            "can_delete": true,
            "granted_at": {
              "var": "time.utc_instant"
            },
            "granted_by": {
              "var": "actor.id"
            },
            "access_label": "Manager - this record and everything under it",
            "company_id": {
              "var": "record_id"
            },
            "write_company_id": {
              "var": "record_id"
            }
          },
          "type": "create_record",
          "trigger_rules": false,
          "target_model_id": "122458df-732b-41b5-934d-907ac748f6d9"
        }
      ]
    }
  },
  "4cbf62b3-14c7-422c-b674-f1805d217b26": {
