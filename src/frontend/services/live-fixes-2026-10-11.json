      "actions": [
        {
          "data": {
            "scope": "subtree",
            "source": "creator",
            "user_id": {
              "var": "actor.id"
            },
            "can_share": true,
            "can_write": true,
            "perm_bits": 15,
            "can_delete": true,
            "granted_at": {
              "var": "time.utc_instant"
            },
            "granted_by": {
              "var": "actor.id"
            },
            "access_label": "Manager - this record and everything under it",
            "project_id": {
              "var": "record_id"
            },
            "write_project_id": {
              "var": "record_id"
            }
          },
          "type": "create_record",
          "trigger_rules": false,
          "target_model_id": "f61184d6-7f3d-4bc1-9bd6-fc9cbd35799a"
        }
      ]
    }
  },
