  "06a76591-db82-4b53-8ed7-bc742770597e": {
    "op": "create_rule",
    "body": {
      "model_id": "fa587fac-8787-42eb-b720-9b2cb2eb73f3",
      "name": "note_file: copy blob id to storage key and checksum",
      "condition": {
        "!=": [
          {
            "var": "after.blob"
          },
          null
        ]
      },
      "actions": [
        {
          "type": "set_fields",
          "fields": {
            "storage_key": {
              "var": "after.blob"
            },
            "checksum": {
              "var": "after.blob"
            }
          }
        }
      ],
      "trigger": "record_create",
      "phase": "pre_save",
      "priority": 10,
      "run_as": "actor",
      "scope": {},
      "settings": {},
      "isActive": true
    }
  },
  "a7dd1096-2642-4936-810d-bd22b28646be": {
    "op": "create_rule",
    "body": {
      "model_id": "fa587fac-8787-42eb-b720-9b2cb2eb73f3",
